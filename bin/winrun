#!/usr/bin/env bash
# shellcheck shell=bash
# 主入口：默认值 + 模块装载 + 分发；变量大多在 lib/ 各模块里使用
# shellcheck disable=SC2034
set -euo pipefail

ORIGINAL_ARGS=("$@")
DEFAULT_PREFIX="${WINRUN_PREFIX:-$HOME/.proton}"
XDG_DATA_HOME_VALUE="${XDG_DATA_HOME:-$HOME/.local/share}"
XDG_CACHE_HOME_VALUE="${XDG_CACHE_HOME:-$HOME/.cache}"
# Runners go where Steam keeps compatibility tools, which other launchers read
# too; earlier versions installed them in LOCAL_RUNNER_DIR, still used.
STEAM_RUNNER_DIR="$HOME/.local/share/Steam/compatibilitytools.d"
LOCAL_RUNNER_DIR="$XDG_DATA_HOME_VALUE/proton/runners"
WRAPPER_CACHE_DIR="$XDG_CACHE_HOME_VALUE/winrun"
INSTALL_DOWNLOAD_DIR="$WRAPPER_CACHE_DIR/downloads"
DOWNLOAD_TIMEOUT_SECONDS="${WINRUN_DOWNLOAD_TIMEOUT:-0}"
DOWNLOAD_STALL_SECONDS="${WINRUN_DOWNLOAD_STALL:-120}"
DOWNLOAD_NOTIFY_INTERVAL="${WINRUN_NOTIFY_INTERVAL:-8}"
DOWNLOAD_NOTIFY_EXPIRE="${WINRUN_NOTIFY_EXPIRE:-8000}"
STEAM_ROOT="${STEAM_COMPAT_CLIENT_INSTALL_PATH:-$HOME/.steam/root}"
# Proton runs inside the Steam Linux Runtime its toolmanifest.vdf asks for;
# set WINRUN_RUNTIME=0 to run it directly on the host.
RUNTIME_ENABLED="${WINRUN_RUNTIME:-1}"
RUNTIME_DIR="$XDG_DATA_HOME_VALUE/winrun/runtime"
RUNTIME_PREFIX=()

# 0 means no total cap: a slow but healthy download must not be killed.
# Stalled transfers are caught by DOWNLOAD_STALL_SECONDS instead.
[[ "$DOWNLOAD_TIMEOUT_SECONDS" =~ ^[0-9]+$ ]] || DOWNLOAD_TIMEOUT_SECONDS=0
[[ "$DOWNLOAD_STALL_SECONDS" =~ ^[0-9]+$ && "$DOWNLOAD_STALL_SECONDS" -gt 0 ]] || DOWNLOAD_STALL_SECONDS=120
[[ "$DOWNLOAD_NOTIFY_INTERVAL" =~ ^[0-9]+$ && "$DOWNLOAD_NOTIFY_INTERVAL" -gt 0 ]] || DOWNLOAD_NOTIFY_INTERVAL=8
[[ "$DOWNLOAD_NOTIFY_EXPIRE" =~ ^[0-9]+$ && "$DOWNLOAD_NOTIFY_EXPIRE" -gt 0 ]] || DOWNLOAD_NOTIFY_EXPIRE=8000

INSTALL_ERROR=""
INSTALL_LOG=""

ACTION=""
PRODUCT=""
VERSION="latest"
PREFIX="$DEFAULT_PREFIX"
RUNNER_ARG="${WINRUN_RUNNER:-}"
DOWNLOAD_DIR=""
INSTALL_DIR=""
INSTALL_TO="default"
CLEAN=0
TARGET=""
TARGET_ARGS=()
# 1 when the target came from a Steam launch option, see take_steam_command
STEAM_LAUNCH=0
LANG_OVERRIDE="${PROTON_LANG:-}"
GAMESCOPE=0
GAMESCOPE_FULLSCREEN=1
GAMESCOPE_RES=""
GAMESCOPE_FPS=""
GAMESCOPE_FSR=0
GAMESCOPE_EXTRA=""
MANGOHUD=0
WAYLAND=0
DEBUG=0
DEBUG_LOG=""
RUN_APP_ID=""
RUN_LOG=""
PREFIX_EXPLICIT=0
RUNNER_EXPLICIT=0
GAMESCOPE_EXPLICIT=0
MANGOHUD_EXPLICIT=0
WAYLAND_EXPLICIT=0
NETNS_ARG=""
# Runner installed and used when nothing else is chosen.
DEFAULT_PRODUCT="we"

if [[ "$0" == */* ]]; then
  SELF_PATH="$(realpath -m "$0")"
else
  SELF_PATH="$(command -v winrun || printf 'winrun')"
fi

RUNNER_TYPES=()
RUNNER_SOURCES=()
RUNNER_NAMES=()
RUNNER_PATHS=()
DEBUG_ENV=()
CACHED_ENV=()
RUN_ENV=()
declare -A RUNNER_SEEN=()

[[ -n "${WINRUN_PREFIX:-}" ]] && PREFIX_EXPLICIT=1
[[ -n "${WINRUN_RUNNER:-}" ]] && RUNNER_EXPLICIT=1


# Modules live in lib/ beside the entry script (repo) or ../lib/winrun (installed).
if [[ -z "${WINRUN_LIB_DIR:-}" ]]; then
  _winrun_self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if [[ -d "$_winrun_self_dir/../lib" ]]; then
    WINRUN_LIB_DIR="$_winrun_self_dir/../lib"
  elif [[ -d "$_winrun_self_dir/../lib/winrun" ]]; then
    WINRUN_LIB_DIR="$_winrun_self_dir/../lib/winrun"
  fi
fi
if [[ -z "${WINRUN_LIB_DIR:-}" || ! -d "$WINRUN_LIB_DIR" ]]; then
  echo "winrun: cannot locate lib/ modules" >&2
  exit 1
fi

source "$WINRUN_LIB_DIR/core.sh"   # locale, debug/run logging, app id
source "$WINRUN_LIB_DIR/usage.sh"   # help texts
source "$WINRUN_LIB_DIR/utils.sh"   # errors, paths, runner discovery and selection
source "$WINRUN_LIB_DIR/product.sh"   # product naming and install dirs
source "$WINRUN_LIB_DIR/runners.sh"   # version lists, download, install/update/remove runners
source "$WINRUN_LIB_DIR/launch.sh"   # Steam runtime, launch command, Gamescope/MangoHud/overlay
source "$WINRUN_LIB_DIR/session.sh"   # sessions and network namespace (pasta keeper)
source "$WINRUN_LIB_DIR/prefix.sh"   # prefix init, cached env/associations, drive maps, targets
source "$WINRUN_LIB_DIR/status.sh"   # status and doctor
source "$WINRUN_LIB_DIR/cli.sh"   # argument parsing
source "$WINRUN_LIB_DIR/helpers.sh"   # re-entrant helper mains (keeper / gamescope / IM watch)

case "${1:-}" in
  --session-keeper)
    session_keeper_main "${2:?}"
    ;;
  --in-gamescope)
    shift
    [[ "${1:-}" == "--" ]] && shift
    gamescope_session_main "$@"
    ;;
  --ime-watch)
    ime_watch_main "${2:?}"
    ;;
esac

parse_args "$@"
PREFIX="$(expand_path "$PREFIX")"
setup_debug_logging

case "$ACTION" in
  list)
    list_runners
    ;;
  list-version)
    list_versions "$PRODUCT"
    ;;
  status)
    show_status
    ;;
  netns)
    netns_command
    ;;
  init)
    init_prefix
    ;;
  winecfg)
    open_winecfg
    ;;
  download)
    download_runner
    ;;
  install)
    install_runner_with_notifications
    ;;
  doctor)
    run_doctor
    ;;
  update)
    update_runner
    ;;
  check-update)
    check_update_runner
    ;;
  remove)
    remove_runner
    ;;
  remove-all)
    remove_all_runners
    ;;
  "")
    if [[ -z "$TARGET" ]]; then
      if [[ $GAMESCOPE -eq 1 ]]; then
        gamescope_usage
        exit 0
      fi
      die "no target provided"
    fi
    run_target
    ;;
  *)
    die "unknown action: $ACTION"
    ;;
esac
