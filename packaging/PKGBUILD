# Maintainer: xinghui79 <xinghui79@qq.com>
# 构建：makepkg -f        （只出包）
# 安装：makepkg -si       （构建 + sudo 装到 /usr）
# 用 rustup 装了 rust 的话，makepkg 会认为缺 cargo：加 --nodeps
#
# source 默认指向 GitHub 仓库；本地开发构建时用环境变量指回本地：
#   PROTONBOOST_REPO="file:///path/to/protonboost" makepkg -f

pkgname=protonboost
pkgver=0.1.0
pkgrel=1
pkgdesc="在 Linux 上用 Proton / Wine 运行 Windows 程序（Rust + Qt 6）"
arch=('x86_64' 'aarch64')
url="https://github.com/xinghui79/protonboost"
license=('MIT')
depends=(
    'qt6-base'
    'qt6-declarative'
    'qt6-svg'
    'curl'
    'tar'
    'util-linux'
)
makedepends=(
    'cargo'
    'cmake'
    'qt6-base'
    'qt6-declarative'
)
optdepends=(
    'passt: 前缀的独立网络（netns）'
    'wine: 没有 Proton 时也可以用它跑程序'
    'icoextract: 从 exe 里抠图标的备用方案'
)
options=('!lto')

_repo="${PROTONBOOST_REPO:-git+https://github.com/xinghui79/protonboost}"
source=("$pkgname::git+$_repo")
sha256sums=('SKIP')

build() {
    cd "$pkgname"
    export CARGO_TARGET_DIR="$srcdir/target"
    cargo build --release --locked
}

package() {
    cd "$pkgname"
    install -Dm755 "$srcdir/target/release/protonboost" \
        "$pkgdir/usr/bin/protonboost"

    local file
    for file in assets/applications/*.desktop; do
        install -Dm644 "$file" "$pkgdir/usr/share/applications/$(basename "$file")"
    done

    install -Dm644 assets/icons/protonboost.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/protonboost.png"
    install -Dm644 assets/icons/protonboost.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/protonboost.svg"
}
