pkgbase = protonboost
	pkgdesc = 在 Linux 上用 Proton / Wine 运行 Windows 程序（Rust + Qt 6）
	pkgver = 0.1.1
	pkgrel = 1
	url = https://github.com/xinghui79/protonboost
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cargo
	makedepends = cmake
	makedepends = git
	makedepends = qt6-base
	makedepends = qt6-declarative
	depends = qt6-base
	depends = qt6-declarative
	depends = qt6-svg
	depends = curl
	depends = tar
	depends = util-linux
	optdepends = passt: 前缀的独立网络（netns）
	optdepends = wine: 没有 Proton 时也可以用它跑程序
	optdepends = icoextract: 从 exe 里抠图标的备用方案
	options = !lto
	source = protonboost::git+https://github.com/xinghui79/protonboost
	sha256sums = SKIP

pkgname = protonboost
